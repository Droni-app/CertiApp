# mysql://USUARIO:CLAVE@HOST:PUERTO/BASE
DATABASE_URL="mysql://certiapp:secret@localhost:3306/certiapp"

# Clave de al menos 32 caracteres para sellar la cookie de sesión (nuxt-auth-utils)
NUXT_SESSION_PASSWORD="cambia-esto-por-una-clave-de-32-caracteres-o-mas"

# Usuario administrador inicial (usado por `npm run db:seed`)
SEED_ADMIN_NAME="Administrador"
SEED_ADMIN_EMAIL="admin@certiapp.local"
SEED_ADMIN_PASSWORD="admin12345"
